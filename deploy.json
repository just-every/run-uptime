{
  "version": 1,
  "project": "runeditrun/uptime-monitor",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "secrets": [
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "MAIL_FROM",
      "environment": "MAIL_FROM"
    },
    {
      "binding": "SENDGRID_API_KEY",
      "environment": "SENDGRID_API_KEY"
    },
    {
      "binding": "UPTIME_RUNNER_KEY",
      "environment": "UPTIME_RUNNER_KEY"
    }
  ],
  "crons": [
    "* * * * *"
  ],
  "originVar": "UPTIME_ORIGIN",
  "platforms": [
    "workers",
    "container"
  ],
  "container": {
    "engine": "workerd",
    "runner": {
      "entry": "runners/src/demo-container.mjs",
      "files": [
        "runners/src",
        "src/domain",
        "src/base",
        "scripts/local-ports.mjs"
      ]
    }
  }
}
