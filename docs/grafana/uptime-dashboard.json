{
  "title": "Uptime \u2014 immutable monitoring figures",
  "uid": "uptime-metrics-v1",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "uptime"
  ],
  "description": "Instant values use the authenticated scrape's configured report window. Unknown, paused and maintenance durations remain separate from observed availability. Probe IDs identify Uptime locations, not Datadog-managed probes.",
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "monitor",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(uptime_availability_defined, monitor_id)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Availability \u2014 report window",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "uptime_availability_percent{monitor_id=~\"$monitor\"}",
          "instant": true,
          "legendFormat": "{{monitor_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Current monitor state (1 = active)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "uptime_monitor_state{monitor_id=~\"$monitor\"} == 1",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "state",
                "monitor_id"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "state": 0,
              "monitor_id": 1
            },
            "renameByName": {
              "__name__": "Measure",
              "Value": "Value",
              "monitor_id": "Monitor",
              "probe_id": "Location",
              "statistic": "Statistic",
              "outcome": "Outcome",
              "state": "State"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Measure"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "uptime_availability_observed_seconds": {
                        "text": "Observed"
                      },
                      "uptime_availability_healthy_seconds": {
                        "text": "Healthy"
                      },
                      "uptime_availability_not_passing_seconds": {
                        "text": "Not passing"
                      },
                      "uptime_availability_unknown_seconds": {
                        "text": "Unknown"
                      },
                      "uptime_availability_paused_seconds": {
                        "text": "Paused"
                      },
                      "uptime_availability_maintenance_seconds": {
                        "text": "Maintenance"
                      },
                      "uptime_coverage_expected": {
                        "text": "Expected probes"
                      },
                      "uptime_coverage_observed": {
                        "text": "Fresh probes"
                      },
                      "uptime_probe_contact_fresh": {
                        "text": "Contact fresh"
                      },
                      "uptime_probe_evidence_fresh": {
                        "text": "Evidence fresh"
                      },
                      "uptime_window_from_timestamp_seconds": {
                        "text": "Window starts"
                      },
                      "uptime_window_to_timestamp_seconds": {
                        "text": "Window ends"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 3,
      "title": "Scrape snapshot age",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
