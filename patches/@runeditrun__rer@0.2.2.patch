+++ b/modules/demo-host/README.md
@@ -0,0 +1,30 @@
+# Hosted demo
+
+The front Worker `rer deploy --demo` deploys at `demo.<domain>` for a seed
+that adopted demo mode (`withDemo`, export/DEMO.md). `plan.mjs` turns `deploy-demo.json`
+into the Worker's Wrangler configuration; the CLI (`cli/demo-host.mjs`) writes
+it with these files and the seed's container image folder (workerd engine) to
+`.rer/demo-host/` and runs `wrangler deploy` there.
+
+- `worker.mjs`: `GET /` is the start page; `POST /__demo/start` checks the
+  exact Origin, the `STARTS` rate limit (3 per IP per 60 s), Turnstile's
+  siteverify and capacity, then starts the visitor's demo and answers with the
+  owner claim's 303, its session cookie and the `rer_demo` cookie. A request
+  with that cookie goes to the visitor's Durable Object; nothing else reaches
+  a container.
+- `container.mjs`: `DemoContainer`, one per visitor (`newUniqueId`, checked
+  with `idFromString`). It starts the container with `enableInternet: false`,
+  `RER_DEMO=1`, the fixed origin (`RER_INGRESS_ORIGIN` and the seed's origin
+  variable), fresh `SESSION_SECRET` and `SETUP_TOKEN`,
+  `OWNER_EMAIL=owner@demo.invalid` and the owner claim's issuer, installation
+  id and public key; waits for `/health`; and posts a five-minute ES256 claim
+  (`claim.mjs`) to `/auth/owner-claim`. Its alarm ends the demo at its hour or
+  after 15 idle minutes: `destroy()`, `deleteAll()` and the place released. A
+  container that stops by itself ends its demo too.
+- `capacity.mjs`: `DemoCapacity` admits at most `max_instances` live demos.
+- `pages.mjs`: the start and ended pages (12ui designs), strict CSP.
+
+`node --test modules/demo-host/tests/*.test.mjs` runs the Worker in workerd
+with its real Durable Objects and rate limit; Turnstile and the container
+platform are the only fakes. The end-to-end proof (`wrangler dev` with Docker)
+is in DEMO.md.
diff --git a/modules/demo-host/capacity.mjs b/modules/demo-host/capacity.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..5d6be299e09906031efa5df499e722a35a3043aa
--- /dev/null
+++ b/modules/demo-host/capacity.mjs
@@ -0,0 +1,19 @@
+import { DurableObject } from 'cloudflare:workers';
+
+// One per demo Worker (idFromName('capacity')): the running demos and their
+// ends. A start is admitted while fewer than max_instances demos are live; a
+// demo releases its place when it ends, and a place past its end is free anyway.
+export class DemoCapacity extends DurableObject {
+  async acquire(id, ends, max) {
+    const now = Date.now(), places = await this.ctx.storage.list();
+    const over = [...places].filter(([, until]) => until <= now).map(([key]) => key);
+    if (over.length) await this.ctx.storage.delete(over);
+    if (places.size - over.length >= max) return false;
+    await this.ctx.storage.put(id, ends);
+    return true;
+  }
+
+  async release(id) {
+    await this.ctx.storage.delete(id);
+  }
+}
diff --git a/modules/demo-host/claim.mjs b/modules/demo-host/claim.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..2460d23a58c0c14d3c3bf74531b19740aa3e1374
--- /dev/null
+++ b/modules/demo-host/claim.mjs
@@ -0,0 +1,21 @@
+// The signed owner claim (modules/owner-claim) a demo's front Worker makes for
+// its container: one ES256 key pair per container, its public JWK given to the
+// container at start, and one five-minute claim signed with the private key,
+// which is never stored.
+const base64url = bytes => btoa(String.fromCharCode(...new Uint8Array(bytes))).replaceAll('+', '-').replaceAll('/', '_').replace(/=+$/, '');
+const segment = value => base64url(new TextEncoder().encode(JSON.stringify(value)));
+
+export async function claimKeys() {
+  const pair = await crypto.subtle.generateKey({ name: 'ECDSA', namedCurve: 'P-256' }, true, ['sign', 'verify']);
+  const { kty, crv, x, y } = await crypto.subtle.exportKey('jwk', pair.publicKey);
+  const kid = crypto.randomUUID().replaceAll('-', '');
+  return { kid, privateKey: pair.privateKey, publicKeys: { [kid]: { kty, crv, x, y, kid, alg: 'ES256', use: 'sig' } } };
+}
+
+/** The compact JWS /auth/owner-claim verifies: issuer and audience are the demo's own origin. */
+export async function signClaim({ kid, privateKey }, { origin, installationId, email, now }) {
+  const iat = Math.floor(now / 1000);
+  const signed = `${segment({ alg: 'ES256', typ: 'rer-owner-claim+jwt', kid })}.${segment({ v: 1, iss: origin, aud: origin, installationId, email, jti: crypto.randomUUID(), iat, exp: iat + 300 })}`;
+  const signature = await crypto.subtle.sign({ name: 'ECDSA', hash: 'SHA-256' }, privateKey, new TextEncoder().encode(signed));
+  return `${signed}.${base64url(signature)}`;
+}
diff --git a/modules/demo-host/container.mjs b/modules/demo-host/container.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c5a26d8543bdc078928c119018afc96c353944c3
--- /dev/null
+++ b/modules/demo-host/container.mjs
@@ -0,0 +1,74 @@
+import { DurableObject } from 'cloudflare:workers';
+import { claimKeys, signClaim } from './claim.mjs';
+import { endedPage, clearCookie } from './pages.mjs';
+
+// One visitor's demo: a Durable Object (newUniqueId) and its container, the
+// seed's image from `rer build --platform container` on the workerd engine.
+// The container starts with no internet and in demo mode, so withDemo and the
+// engine's egress worker refuse every send. The front signs the owner in
+// through the existing signed owner claim. The demo ends at its hour or after
+// 15 idle minutes: the alarm destroys the container and deletes everything.
+const PORT = 8080, IDLE = 15 * 60_000, OWNER = 'owner@demo.invalid';
+// The container's port speaks plain HTTP; the app takes its public origin from RER_INGRESS_ORIGIN.
+const inside = url => `http://container${url.pathname}${url.search}`;
+const random = () => [...crypto.getRandomValues(new Uint8Array(32))].map(byte => byte.toString(16).padStart(2, '0')).join('');
+
+export class DemoContainer extends DurableObject {
+  idle = IDLE;
+  get container() { return this.ctx.container; }
+  port() { return this.container.getTcpPort(PORT); }
+
+  /** Start the container, wait for /health, claim the owner; returns the claim's 303. */
+  async start({ origin, originVar, ends, endsLocal, settings }) {
+    const id = this.ctx.id.toString(), keys = await claimKeys(), now = Date.now();
+    await this.ctx.storage.put({ ends, seen: now });
+    await this.ctx.storage.setAlarm(Math.min(ends, now + this.idle));
+    this.container.start({ enableInternet: false, env: { ...settings, RER_DEMO: '1', [originVar]: origin, RER_INGRESS_ORIGIN: origin,
+      SESSION_SECRET: random(), SETUP_TOKEN: random(), OWNER_EMAIL: OWNER, RER_OWNER_CLAIM_ISSUER: origin, RER_OWNER_CLAIM_INSTALLATION_ID: id,
+      RER_OWNER_CLAIM_PUBLIC_KEYS: JSON.stringify(keys.publicKeys), RER_DEMO_EXPIRES: endsLocal } });
+    // A container that stops by itself ends the demo too.
+    this.container.monitor().then(() => this.end(), () => this.end());
+    await this.healthy();
+    const token = await signClaim(keys, { origin, installationId: id, email: OWNER, now: Date.now() });
+    const claimed = await this.port().fetch('http://container/auth/owner-claim', { method: 'POST', redirect: 'manual',
+      headers: { origin, 'content-type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ token }) });
+    await claimed.body?.cancel();
+    if (claimed.status !== 303) throw new Error(`owner claim answered ${claimed.status}`);
+    return { location: claimed.headers.get('location'), cookies: claimed.headers.getSetCookie() };
+  }
+
+  async healthy() {
+    for (const deadline = Date.now() + 120_000; ;) {
+      try {
+        const response = await this.port().fetch('http://container/health');
+        await response.body?.cancel();
+        if (response.ok) return;
+      } catch { /* The container is still starting. */ }
+      if (Date.now() > deadline) throw new Error('demo container never became healthy');
+      await new Promise(resolve => setTimeout(resolve, 250));
+    }
+  }
+
+  /** Every request carrying this demo's cookie: proxied while the demo lives, else the ended page. */
+  async fetch(request) {
+    const state = await this.ctx.storage.get(['ends', 'seen']), now = Date.now();
+    if (!(state.get('ends') > now)) return endedPage(this.env, { status: 410, headers: { 'set-cookie': clearCookie(this.env) } });
+    if (now - state.get('seen') > 60_000) await this.ctx.storage.put('seen', now);
+    return this.port().fetch(new Request(inside(new URL(request.url)), request));
+  }
+
+  async alarm() {
+    const state = await this.ctx.storage.get(['ends', 'seen']), now = Date.now();
+    if (!state.get('ends')) return;
+    if (now >= state.get('ends') || now - state.get('seen') >= this.idle) return this.end();
+    await this.ctx.storage.setAlarm(Math.min(state.get('ends'), state.get('seen') + this.idle));
+  }
+
+  /** Destroy the container and delete this demo's state and place; safe to repeat. */
+  async end() {
+    if (this.container.running) await this.container.destroy().catch(() => { /* Already stopping. */ });
+    await this.ctx.storage.deleteAlarm();
+    await this.ctx.storage.deleteAll();
+    await this.env.CAPACITY.get(this.env.CAPACITY.idFromName('capacity')).release(this.ctx.id.toString());
+  }
+}
