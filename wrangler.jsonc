{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uptime-uptime-console",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uptime-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "MAIL_PROVIDER": "rer",
    "MAIL_FROM": "",
    "MAIL_RELAY_URL": ""
  }
}
