+    if len(fields) < 6 or [field[0] for field in fields[:6]] != [INTEGER] + [SEQUENCE] * 5:
+        return None
+    issuer, subject = name_values(data, fields[2]), name_values(data, fields[4])
+    if issuer is None or subject is None:
+        return None
