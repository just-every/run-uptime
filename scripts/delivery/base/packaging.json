{
  "schema": 1,
  "project": {
    "schema": 1,
    "projectId": "just-every/uptime-monitor",
    "name": "Uptime",
    "sourceRepository": "https://github.com/just-every/run-uptime",
    "license": "MIT",
    "deployment": {
      "target": "cloudflare-workers",
      "artifactFile": "rer-worker-artifact.json"
    },
    "operations": {
      "setup": "bash scripts/delivery/setup-build.sh",
      "build": "export PATH=\"$PWD/.rer-tools/node_modules/.bin:$PATH\" && pnpm exec rer build",
      "verify": "export PATH=\"$PWD/.rer-tools/node_modules/.bin:$PATH\" && pnpm exec rer check --profile first-party && node scripts/edition-authoring/cli.mjs check && node scripts/edition-authoring/cli.mjs verify-base --offline && pnpm spec:check",
      "artifact": "export PATH=\"$PWD/.rer-tools/node_modules/.bin:$PATH\" && node scripts/build-delivery-artifact.mjs",
      "recovery": "Preserve the private deployment receipt and D1 migration ledger. Restore archives into an empty installation with monitors paused and alerts quarantined."
    },
    "verification": {
      "sensitivePaths": [
        "src/domain/operator-auth.server.ts",
        "src/server.ts",
        "src/base/modules/operator-auth/**",
        "src/base/modules/mail/**",
        "src/base/modules/integrations/**",
        "runners/src/public-http.mjs",
        "scripts/local-settings.mjs",
        "public/destination-dialog.js",
        "src/domain/notification-content.ts",
        "src/domain/notification-cancellation.server.ts",
        "src/domain/notification-credentials.server.ts",
        "src/domain/notification-destinations.server.ts",
        "src/domain/notification-mail.server.ts",
        "src/domain/notification-protocols.ts",
        "src/domain/notification-rpc.server.ts",
        "src/domain/notifications.server.ts",
        "runners/src/credentials.mjs",
        "runners/src/notification-dispatch.mjs",
        "src/domain/notification-claims.server.ts",
        "public/notification-dialogs.js",
        "public/alert-drills.js",
        "src/domain/alert-drill*.ts",
        "src/domain/auth-document.server.ts",
        "scripts/installer/**",
        "scripts/deployment/owner-*.mjs",
        "src/domain/archive*.ts",
        "scripts/local/**",
        "rer-setup.json",
        "rer-local-setup.json",
        "management/integration/deployment-spec.json",
        "src/base/modules/owner-claim/**",
        "src/base/modules/editor/**",
        "src/editor/**",
        "src/domain/editor.server.ts",
        "src/domain/owner-claim.server.ts",
        "scripts/delivery/**",
        ".github/workflows/rer-managed.yml",
        "src/domain/first-run.server.ts"
      ],
      "migrationDirectories": [
        "migrations"
      ],
      "guidanceFiles": [
        "AGENTS.md",
        "CONTRACT.md",
        "OPERATIONS.md"
      ],
      "testPatterns": [
        "tests/*.mjs"
      ]
    }
  },
  "managed": {
    "workflowRef": "runeditrun/delivery/.github/workflows/trusted-build.yml@86c8b37399c901bffd9a240dbd1148a65ec83b34",
    "artifactFile": "rer-worker-artifact.json",
    "buildProfile": "project",
    "verificationProfiles": [
      "full"
    ],
    "pnpmVersion": "10.12.4"
  },
  "setup": {
    "manifestFile": "rer-setup.json"
  },
  "artifact": {
    "specInputs": {
      "publicVariableNames": [
        "UPTIME_ORIGIN",
        "OWNER_EMAIL",
        "MAIL_PROVIDER",
        "MAIL_FROM",
        "RER_MANAGEMENT_ORIGIN",
        "RER_INSTALLATION_ID",
        "RER_OWNER_CLAIM_ISSUER",
        "RER_OWNER_CLAIM_INSTALLATION_ID",
        "RER_OWNER_CLAIM_APP_ORIGIN",
        "RER_OWNER_CLAIM_PUBLIC_KEYS",
        "MAIL_ACCOUNT_ID",
        "UPTIME_START_URL",
        "MAIL_RELAY_URL"
      ],
      "secretNames": [
        "SESSION_SECRET",
        "SETUP_TOKEN",
        "UPTIME_RUNNER_KEY"
      ],
      "optionalSecretNames": [
        "SENDGRID_API_KEY",
        "MAIL_PROVIDER_API_KEY",
        "CLOUDFLARE_MAIL_API_KEY",
        "UPTIME_HEARTBEAT_URL",
        "MAIL_API_KEY"
      ],
      "providerEffects": [
        "outbound-mail",
        "outbound-webhooks",
        "outbound-http"
      ],
      "surfaces": {
        "app": {
          "path": "/",
          "signIn": {
            "path": "/login",
            "loginHint": true
          },
          "originVariable": "UPTIME_ORIGIN",
          "readiness": [
            {
              "path": "/health",
              "statuses": [
                200
              ]
            }
          ]
        }
      },
      "recovery": "Preserve the private deployment receipt and D1 migration ledger. Restore archives into an empty installation with monitors paused and alerts quarantined.",
      "mail": {
        "providers": [
          "rer"
        ]
      }
    }
  }
}
